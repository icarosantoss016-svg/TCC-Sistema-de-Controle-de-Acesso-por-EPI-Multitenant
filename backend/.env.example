#Configurações do SafeZone Backend

PORT=3000
SECRET=sua_chave_secreta_jwt_aqui

#Banco de Dados (PostgreSQL)

DB_DIALECT=postgres
DB_SSL=true

#pção 1: Conexão via String Completa (Recomendado para Neon / Supabase / Render)

DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require

#Opção 2: Conexão via Variáveis Individuais (Uso Local / PostgreSQL tradicional)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=safezone_db
DB_USER=postgres
DB_PASSWORD=sua_senha_local